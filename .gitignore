# Editor and IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Go (anticipated; not yet decided)
*.exe
*.test
*.out
/vendor/
/bin/

# Accidental binaries from `go build ./cmd/X/` (no `-o` flag) at
# services/ingestion/ — the binary name matches the cmd subdir name.
/services/ingestion/ghost-trace
/services/ingestion/bench-architecture

# Node (anticipated for simulator/frontend)
node_modules/
npm-debug.log
yarn-error.log
.next/
dist/

# Python (anticipated for experiments)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Build artifacts
/build/
/out/
/target/

# Coverage output (make coverage); CI keeps it as a run artifact
/.coverage/

# Per-developer lefthook overrides (lefthook.yml itself is committed)
lefthook-local.yml

# Logs and local state
*.log
.local/
tmp/

# Secrets and local config
.env
.env.local
*.pem
*.key

# Generated docs
/site/

# M1 local run data
services/ingestion/.run-data/

# Local agent-tooling state — recreated by tooling, never repo content
.claude/
.mcp.json

# dotcontext runtime state. CLAUDE.md is NOT here: it is a generated
# export of .context/docs/README.md, committed and drift-gated like
# every other generated artifact. .claude/ stays local — it is a
# per-tool rendering, not repository content.
.context/plans/
.context/cache/semantic/
.context/runtime/
.context/**/archive/


# go.work is committed; go.work.sum is not. CI builds every module with
# GOWORK=off and the container build never sees the workspace at all
# (ADR-0001), so nothing that gates this repository reads this file —
# its contents depend on which modules a given developer has resolved,
# which is churn no check would catch going wrong.
go.work.sum
