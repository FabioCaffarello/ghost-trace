# Compose configuration. Copy to .env (gitignored), then pin the base
# images: deploy/docker/pin-base-images.sh
#
# The *_IMAGE values below are floating tags; the pin script replaces
# them with sha256 digests so a rebuild months from now uses the same
# base layers.

GOLANG_IMAGE=golang:1.26-alpine
DISTROLESS_IMAGE=gcr.io/distroless/static-debian12:nonroot
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0

IMAGE_TAG=dev

# Tenant keys. The demo defaults are fine locally; anything reachable
# by others gets real values.
GT_SITE_KEY=pk_demo
GT_SECRET_KEY=sk_demo
GT_MODE=monitor
