# Compose configuration. Copy to .env (gitignored), then pin the base
# images: deploy/docker/pin-base-images.sh
#
# The *_IMAGE values below are floating tags; the pin script replaces
# them with sha256 digests so a rebuild months from now uses the same
# base layers.

GOLANG_IMAGE=golang:1.26-alpine
DISTROLESS_IMAGE=gcr.io/distroless/static-debian12:nonroot
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
NATS_IMAGE=nats:2.10-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0

IMAGE_TAG=dev

# Tenant keys. The demo defaults are fine locally; anything reachable
# by others gets real values.
GT_SITE_KEY=pk_demo
GT_SECRET_KEY=sk_demo
GT_MODE=monitor

# The demo page's origin, as the BROWSER sees it. The collector
# allowlists it for /v1/sessions and /v1/telemetry; change one and you
# must change the other, or every SDK request from the page is refused
# by the browser with nothing in any log saying why.
GT_DEMO_ORIGIN=http://127.0.0.1:8083
GT_API_ORIGIN=http://127.0.0.1:8080

# The human study's capture log, as a path INSIDE the demo-web
# container: ./experiments/results is mounted at /captures, so
# /captures/human_sessions.jsonl is what analyze.py then reads on the
# host. Empty disables capture, which is the right default — a study
# that is not running should record nobody.
#
# It replaces a second demo-web service that carried the flag by
# construction. A variable can be forgotten where a service could not
# be, so `make capture-dryrun` refuses a run whose capture log did not
# grow rather than reporting three participants and no rows.
GT_CAPTURE_LOG=

# Dialled by demo-web SERVER-SIDE, from inside the compose network, so
# it is a service name and not a host address. Fail-open (§5) turns a
# wrong value here into a demo that answers "allow" forever and looks
# healthy; `make shadow-http` is what catches it.
GT_ENGINE_SERVICE=http://decision-engine:8082
